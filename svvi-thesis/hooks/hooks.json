{
  "description": "Sync SVVI corpus + notice pending Prompt 1/2 jobs",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "SVVI_MCP_TOKEN='${user_config.mcp_token}' bash \"${CLAUDE_PLUGIN_ROOT}/scripts/sync-corpus.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pending-jobs-notice.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
